{
  "name": "ai-brain-trust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 智囊团 —— 移动端 Web 应用（Vue 3 + Vite + TypeScript）",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "android:sync": "pnpm build && cap sync android",
    "android:build": "pnpm android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@tensorflow/tfjs": "^4.22.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
